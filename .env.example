# Copy to .env and fill in. Never commit .env.

# LLM provider and model (model must have an entry in config/models.yaml)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-nano
OPENAI_API_KEY=

# Cost discipline
# Per call:
LLM_MAX_OUTPUT_TOKENS=800
# Per request, across all calls (intent + retry + answer):
REQUEST_TOKEN_BUDGET=6000

# Tracing (LangSmith). Set LANGSMITH_TRACING=false in CI and tests.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wealth-copilot
